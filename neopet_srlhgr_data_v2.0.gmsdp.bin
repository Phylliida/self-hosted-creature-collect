			"Tough Book": {"icon": "tough_book.png", "desc": "\"Kacheek Exercise\""},
			"Babaa": {"icon": "babaa.png", "desc": "Babaas are easily scared and will hide under your Neopets bed when suprised."},
			"Huggy": {"icon": "huggy.png", "desc": "Huggies gives a hug to anyone they sees. They can be quite overly friendly and sometimes annoyingly so."},
			"Kookith": {"icon": "kookith.png", "desc": "Kookith are rectangular in shape, but very loyal, and very very cute."},
			"Noilkeet": {"icon": "noilkeet.png", "desc": "A Noilkeet is a fluffy, bouncy companion who just loves Deckball!"},
			"Splyke": {"icon": "splyke.png", "desc": "Splyke seems to be always shocked at something... and is startled very easily. Do not make loud noises or sudden jerky movements in its vicinity."},
			"Turdle": {"icon": "turdle.png", "desc": "This little guy used to be able to fit into its shell, but as a fully grown turdle it is too big. You can now give it a home."},
			"Warf": {"icon": "warf.png", "desc": "A Warf is a cross between a thingy, and erm...something else!"},
			"Blue Acara Plushie": {"icon": "plush_acara_blue.png", "desc": "Everybodys favourite underwater Neopian. This stylish blue soft toy makes an excellent gift idea."},
			"Green Acara Plushie": {"icon": "plush_acara_green.png", "desc": "Everybodys favourite underwater Neopian. This stylish green soft toy makes an excellent gift idea."},
			"Red Acara Plushie": {"icon": "plush_acara_red.png", "desc": "Everybodys favourite underwater Neopian. This stylish red soft toy makes an excellent gift idea."},
