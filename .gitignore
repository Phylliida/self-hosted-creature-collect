maps\-data/
regions/
CreatureCollect\.apk
CreatureCollect\.ipa
# Top-level downloaded data directories (tilemaker inputs, etc.).
# IMPORTANT: these MUST be anchored with a leading slash so they
# match ONLY the repo-root directories, not `data/BundledData/icons/`
# or `data/BundledData/fonts/`. An unanchored `icons/` excludes any
# directory named `icons` at any depth, which silently dropped the
# bundled icon set from CI builds — the IPA shipped without them and
# POIs / fonts rendered as defaults.
/fonts/
# Ignore everything in data/ EXCEPT BundledData/ — the bundle is
# pure static data generated by build-bundled-data.py (~135 MB),
# small enough to commit so consumers can fetch from GitHub
# directly instead of needing the heavy upstream sources
# (InfiniteFusion, mbtiles, etc.) to regenerate it.
# Note: must exclude `data/*` (contents) rather than `data/`
# (the dir itself); git won't recurse into a fully-excluded dir,
# which would defeat the negation.
data/*
!data/BundledData/
# Track only the source NamesList.txt under data/UnicodeData/ (the iOS
# keyboard's Unicode source). The keyboard dataset (blocks.json, chars.idx,
# names.blob) is regenerated by scripts/build-unicode-data.py in CI, so it
# stays ignored — same pattern as data/BundledData/ above. Re-include the
# directory first, then re-ignore its contents, then keep just the source.
!data/UnicodeData/
data/UnicodeData/*
!data/UnicodeData/NamesList.txt
/osmpbf/
/icons/
/landcover/
.direnv/
saves/

# Capacitor / Node tooling — generated, don't commit.
node_modules/
android/
ios/
.gradle/
*.iml

# Generated by scripts/build-capacitor.sh — composed of static/ +
# data/BundledData/, both already in the repo.
dist/
